# Copy this file to config/openAI.env and fill in the values.
# config/openAI.env is private and ignored by Git. Never commit a real key.
# The key tracking ID is not needed by the image-edit API.
OPENAI_API_KEY="YOUR_KEY_HERE"
PHOTO_EDIT_MODEL="gpt-image-2.5-sunburst"
# Planning estimate per image, in USD. This is not an API spending cap.
PHOTO_EDIT_PLANNING_COST_USD="0.10"
